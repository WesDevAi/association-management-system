# ============================================================================
# AMS environment configuration — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# RULES
#   * `.env` is gitignored and must NEVER be committed, pushed, or shared.
#   * This file may only ever contain placeholders/examples — no secrets.
#   * Generate a secret with:   openssl rand -base64 32
#   * Required variables are validated at server startup (src/lib/env.ts);
#     a missing/invalid value fails fast with a clear error instead of
#     allowing the app to boot with a broken auth or database configuration.
# ============================================================================

# ---------------------------------------------------------------------------
# Database (REQUIRED, all environments)
# ---------------------------------------------------------------------------
# Local example:   postgresql://postgres:postgres@localhost:5432/ams_dev
# Hosted example:  postgresql://user:password@host:5432/dbname?sslmode=require
#
# Neon:     use the pooled connection string (pgbouncer) for the app, and the
#           direct (non-pooled) string for migrations if you hit prepared-
#           statement errors with `prisma migrate`.
# Supabase: use the Session pooler (IPv4) string for serverless hosts.
DATABASE_URL="postgresql://user:password@localhost:5432/ams_dev"

# ---------------------------------------------------------------------------
# Application URL (REQUIRED, all environments)
# ---------------------------------------------------------------------------
# Absolute base URL of this deployment. Used to build links and to configure
# the auth callback origin. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth (Auth.js / NextAuth v5)
# ---------------------------------------------------------------------------
# REQUIRED in production — startup validation rejects a missing or short
# AUTH_SECRET when NODE_ENV=production. Optional in development (Auth.js
# falls back to a generated dev secret), but you should set one anyway.
AUTH_SECRET=""

# Optional. Auto-derived from NEXT_PUBLIC_APP_URL when unset. Set it only if
# the auth base URL differs from the app URL (e.g. proxied path).
# AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Application defaults (optional)
# ---------------------------------------------------------------------------
# Default currency for newly created associations.
DEFAULT_CURRENCY="NGN"

# ---------------------------------------------------------------------------
# Transactional email (Phase 17; required to send reset links and invitations)
# ---------------------------------------------------------------------------
# Create an API key at https://resend.com/api-keys and verify a sender domain.
# Keep both values server-only; never use a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=""
EMAIL_FROM="AMS <no-reply@example.com>"
